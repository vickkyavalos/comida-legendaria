]}]}],"actions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Dylan","Animation","=","\"Golpes\""]}]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"ButtonFSM","type":"ButtonStates::ButtonFSM"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Health","type":"Health::Health"},{"name":"Object3D","type":"Scene3D::Base3DBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"}]}],"externalEvents":[],"tests":[{"description":"Dylan stays on floor, moves right and jumps","lastRunAt":1790564033177.0,"lastRunDurationMs":870.0,"lastRunFramesExecuted":141,"lastRunStatus":"passed","name":"dylan-moves","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(60);","const d0 = harness.getObjects('Dylan')[0];","harness.assert(d0.y < 600, 'Dylan no atraviesa el suelo (y=' + d0.y + ')');","const x0 = d0.centerX;","harness.setKeyPressed('d', true);","await harness.stepFrames(60);","harness.setKeyPressed('d', false);","const d1 = harness.getObjects('Dylan')[0];","harness.assert(d1.centerX > x0 + 50, 'Dylan se mueve a la derecha con D (de ' + x0 + ' a ' + d1.centerX + ')');","const yBefore = d1.centerY;","harness.setKeyPressed('w', true);","await harness.stepFrames(10);","harness.setKeyPressed('w', false);","await harness.stepFrames(10);","const d2 = harness.getObjects('Dylan')[0];","harness.assert(d2.centerY < yBefore - 5, 'Dylan salta con W (de ' + yBefore + ' a ' + d2.centerY + ')');","await harness.takeScreenshot('player-fixed');"]},{"description":"Dylan flips left/right","lastRunAt":1790565065007.0,"lastRunDurationMs":181636.0,"lastRunFramesExecuted":91,"lastRunStatus":"passed","name":"dylan-flip","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(30);","harness.setKeyPressed('a', true);","await harness.stepFrames(30);","harness.setKeyPressed('a', false);","const d = harness.getObjects('Dylan')[0];","console.log(JSON.stringify(d.state));","harness.assert(harness.getRuntimeObject(d.id).isFlippedX() === true, 'Dylan mira a la izquierda (flip X activado)');","harness.setKeyPressed('d', true);","await harness.stepFrames(30);","harness.setKeyPressed('d', false);","const d2 = harness.getObjects('Dylan')[0];","harness.assert(harness.getRuntimeObject(d2.id).isFlippedX() === false, 'Dylan mira a la derecha (flip X desactivado)');"]},{"description":"Dylan idle/walk/run/hit/death animations","lastRunAt":1792644242236.0,"lastRunDurationMs":580.0,"lastRunFramesExecuted":360,"lastRunStatus":"passed","name":"dylan-full-moves","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(90);","let d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'IDLE', 'Empieza en IDLE, actual: ' + d.animation);","const x0 = d.centerX;","harness.setKeyPressed('d', true);","await harness.stepFrames(40);","d = harness.getObjects('Dylan')[0];","harness.assert(d.centerX > x0 + 15, 'Camina derecha');","harness.assert(d.animation === 'walk', 'walk al caminar, actual: ' + d.animation);","harness.setKeyPressed('d', false);","await harness.stepFrames(20);","harness.setKeyPressed('LShift', true);","harness.setKeyPressed('d', true);","await harness.stepFrames(15);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'run', 'run al correr con Shift, actual: ' + d.animation);","harness.setKeyPressed('d', false);","harness.setKeyPressed('LShift', false);","await harness.stepFrames(20);","const x2 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('a', true);","await harness.stepFrames(40);","harness.setKeyPressed('a', false);","d = harness.getObjects('Dylan')[0];","harness.assert(d.centerX < x2 - 15, 'Camina izquierda');","await harness.stepFrames(20);","harness.setKeyPressed('h', true);","await harness.stepFrames(2);","harness.setKeyPressed('h', false);","await harness.stepFrames(5);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'golpeado', 'golpeado tras H, actual: ' + d.animation);","await harness.stepFrames(60);","harness.setKeyPressed('j', true);","await harness.stepFrames(5);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'Golpes', 'Golpes al pulsar J, actual: ' + d.animation);","harness.setKeyPressed('j', false);","await harness.stepFrames(30);","harness.setKeyPressed('k', true);","await harness.stepFrames(2);","harness.setKeyPressed('k', false);","await harness.stepFrames(10);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'Muerte', 'Muerte tras K, actual: ' + d.animation);","await harness.takeScreenshot('final');"]},{"description":"WASD and arrows move Dylan","lastRunAt":1792644983721.0,"lastRunDurationMs":859.0,"lastRunFramesExecuted":377,"lastRunStatus":"passed","name":"dylan-wasd-arrows","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(90);","let d = harness.getObjects('Dylan')[0];","const cx = d.centerX;","// A izquierda"," harness.setKeyPressed('a', true); await harness.stepFrames(30); harness.setKeyPressed('a', false);","let d1 = harness.getObjects('Dylan')[0];","harness.assert(d1.centerX < cx - 10, 'A mueve izquierda');","await harness.stepFrames(20);","// D derecha","const cx2 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('d', true); await harness.stepFrames(30); harness.setKeyPressed('d', false);","let d2 = harness.getObjects('Dylan')[0];","harness.assert(d2.centerX > cx2 + 10, 'D mueve derecha');","await harness.stepFrames(20);","// Flecha izquierda","const cx3 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('Left', true); await harness.stepFrames(30); harness.setKeyPressed('Left', false);","let d3 = harness.getObjects('Dylan')[0];","harness.assert(d3.centerX < cx3 - 10, 'Flecha izq mueve');","await harness.stepFrames(20);","// Flecha derecha","const cx4 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('Right', true); await harness.stepFrames(30); harness.setKeyPressed('Right', false);","let d4 = harness.getObjects('Dylan')[0];","harness.assert(d4.centerX > cx4 + 10, 'Flecha der mueve');","// W salta","await harness.stepFrames(20);","const y0 = harness.getObjects('Dylan')[0].centerY;","harness.setKeyPressed('w', true); await harness.stepFrames(10); harness.setKeyPressed('w', false);","await harness.stepFrames(10);","let d5 = harness.getObjects('Dylan')[0];","harness.assert(d5.centerY < y0 - 5, 'W salta (y ' + y0 + ' -> ' + d5.centerY + ')');","// Up salta","await harness.stepUntilObjectIsStable('Dylan', {maxFrames: 120});","const y1 = harness.getObjects('Dylan')[0].centerY;","harness.setKeyPressed('Up', true); await harness.stepFrames(10); harness.setKeyPressed('Up', false);","await harness.stepFrames(10);","let d6 = harness.getObjects('Dylan')[0];","harness.assert(d6.centerY < y1 - 5, 'Up salta');","await harness.takeScreenshot('final');"]},{"description":"Camera X follow fixed Y","lastRunAt":1792646887541.0,"lastRunDurationMs":932.0,"lastRunFramesExecuted":234,"lastRunStatus":"passed","name":"dylan-camera","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(90);","const cam0 = harness.getCameraState('');","harness.setKeyPressed('d', true);","await harness.stepFrames(120);","harness.setKeyPressed('d', false);","const cam1 = harness.getCameraState('');","const d1 = harness.getObjects('Dylan')[0];","harness.assert(Math.abs(cam1.x - cam0.x) > 20, 'Camara sigue en X (' + Math.round(cam0.x) + ' -> ' + Math.round(cam1.x) + ')');","harness.assert(Math.abs(cam1.y - cam0.y) < 5, 'Camara fija en Y (' + Math.round(cam0.y) + ' -> ' + Math.round(cam1.y) + ')');","// saltar: la camara no debe moverse en Y","const camJ0 = harness.getCameraState('');","harness.setKeyPressed('w', true); await harness.stepFrames(8); harness.setKeyPressed('w', false);","await harness.stepFrames(15);","const camJ1 = harness.getCameraState('');","harness.assert(Math.abs(camJ1.y - camJ0.y) < 5, 'Al saltar no se ve vacio (Y estable)');","await harness.takeScreenshot('camara-fija');"]},{"description":"Intro MUTE button toggles Silenciado and SKIP button jumps to Nivel 1","lastRunAt":1793220700055.0,"lastRunDurationMs":1425.0,"lastRunFramesExecuted":25,"lastRunStatus":"passed","name":"intro-buttons","type":"gameplay","source":["await harness.goToScene('introduccion');","await harness.stepFrames(3);","const mute = harness.getObjects('MuteButton');","const skip = harness.getObjects('SkipButton');","harness.assert(mute.length === 1, 'MuteButton exists on intro scene');","harness.assert(skip.length === 1, 'SkipButton exists on intro scene');","","async function click(x, y) {","  harness.setMousePosition(x, y);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepFrames(3);","}","","const mcx = mute[0].centerX, mcy = mute[0].centerY;","await click(mcx, mcy);","const v1 = harness.getSceneVariable('Silenciado');","harness.assert(!!v1 && v1.value === true, 'First MUTE click sets Silenciado to true (was ' + JSON.stringify(v1 && v1.value) + ')');","await click(mcx, mcy);","const v2 = harness.getSceneVariable('Silenciado');","harness.assert(!!v2 && v2.value === false, 'Second MUTE click sets Silenciado back to false (was ' + JSON.stringify(v2 && v2.value) + ')');","","harness.assert(harness.getSceneName() === 'introduccion', 'Still on intro scene before pressing SKIP');","await click(skip[0].centerX, skip[0].centerY);","harness.assert(harness.getSceneName() === 'Nivel 1', 'SKIP button jumps to Nivel 1 (current: ' + harness.getSceneName() + ')');"]},{"description":"Pixel-art intro controls: mute frame bottom-left toggles volume, chevron icon top-right skips to Nivel 1","lastRunAt":1793221381324.0,"lastRunDurationMs":1527.0,"lastRunFramesExecuted":25,"lastRunStatus":"passed","name":"intro-pixel-controls","type":"gameplay","source":["await harness.goToScene('introduccion');","await harness.stepFrames(3);","const frame = harness.getObjects('BotonPixel');","const skip = harness.getObjects('IconoSkip');","harness.assert(frame.length === 1, 'BotonPixel (pixel mute frame) exists');","harness.assert(skip.length === 1, 'IconoSkip (pixel chevron) exists');","harness.assert(skip[0].x > 400 && skip[0].y < 50, 'skip icon sits in the top-right corner (' + skip[0].x + ',' + skip[0].y + ')');","","async function click(x, y) {","  harness.setMousePosition(x, y);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepFrames(3);","}","","await click(frame[0].centerX, frame[0].centerY);","const v1 = harness.getSceneVariable('Silenciado');","harness.assert(!!v1 && v1.value === true, 'clicking the pixel MUTE frame mutes (was ' + JSON.stringify(v1 && v1.value) + ')');","const label1 = harness.getObjects('EtiquetaMute')[0];","harness.assert(label1 && label1.text === 'UNMUTE', 'pixel label switches to UNMUTE (got ' + (label1 && label1.text) + ')');","","await click(frame[0].centerX, frame[0].centerY);","const v2 = harness.getSceneVariable('Silenciado');","harness.assert(!!v2 && v2.value === false, 'second click unmutes (was ' + JSON.stringify(v2 && v2.value) + ')');","const label2 = harness.getObjects('EtiquetaMute')[0];","harness.assert(label2 && label2.text === 'MUTE', 'pixel label back to MUTE (got ' + (label2 && label2.text) + ')');","","await click(skip[0].centerX, skip[0].centerY);","harness.assert(harness.getSceneName() === 'Nivel 1', 'clicking the top-right skip icon jumps to Nivel 1 (current: ' + harness.getSceneName() + ')');"]},{"description":"Manual UI layout and playability","lastRunAt":1793243342446.0,"lastRunDurationMs":1788.0,"lastRunFramesExecuted":151,"lastRunStatus":"passed","name":"manual-ui-check","type":"gameplay","source":["await harness.goToScene('manual');","await harness.stepFrames(30);","// UI texts present","for (const t of ['ManualTitulo','ManualMovimiento','ManualIzquierda','ManualDerecha','ManualArriba','ManualAbajo','ManualEspacio']) {","  const o = harness.getObjects(t);","  harness.assert(o.length > 0, t+' exists');","}","const titulo = harness.getObjects('ManualTitulo')[0];","harness.assert((titulo.text||'').includes('CÓMO JUGAR'), 'title text ok: '+titulo.text);","// keys present with right animations","for (const [o,exp] of [['TeclaA','A'],['TeclaD','D'],['TeclaW','W'],['TeclaJ','J'],['TeclaK','K']]) {","  const k = harness.getObjects(o);","  harness.assert(k.length > 0, o+' exists');","  if (k.length) harness.assert(k[0].animation === exp, o+' anim '+k[0].animation+' expected '+exp);","}","// arrows + space glyphs","for (const g of ['FlechaT_Izq','FlechaT_Der','FlechaT_Up','FlechaT_Down','BarraEsp']) harness.assert(harness.getObjects(g).length>0, g+' exists');","// Dylan on floor, moves right","await harness.stepFrames(60);","const x0 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('d', true);","await harness.stepFrames(60);","harness.setKeyPressed('d', false);","const x1 = harness.getObjects('Dylan')[0].centerX;","harness.assert(x1 > x0 + 20, 'Dylan moves on floor');","await harness.takeScreenshot('manual-ui');"]},{"description":"Gap fall and respawn check v3","lastRunAt":1793244625618.0,"lastRunDurationMs":2350.0,"lastRunFramesExecuted":74,"lastRunStatus":"passed","name":"manual-gap-fall","type":"gameplay","source":["await harness.goToScene('manual');","await harness.stepFrames(30);","const d = harness.getObjects('Dylan')[0];","harness.setObjectPosition(d.id, 610, 100);","const fell = await harness.stepUntil(() => {","  const p = harness.getObjects('Dylan')[0];","  return p && p.y > 300;","}, {maxFrames: 300});","harness.assert(fell, 'Dylan falls through the gap (no floor at x=610)');","const back = await harness.stepUntil(() => {","  const p = harness.getObjects('Dylan')[0];","  return p && p.y < 200;","}, {maxFrames: 300});","harness.assert(back, 'Dylan respawned after falling');","const p2 = harness.getObjects('Dylan')[0];","harness.assert(Math.abs(p2.x - 40) < 80, 'respawned near start, x='+p2.x);"]},{"description":"Fade transition on bridge exit","lastRunAt":1793246629187.0,"lastRunDurationMs":4294.0,"lastRunFramesExecuted":97,"lastRunStatus":"passed","name":"manual-skip-bridge","type":"gameplay","source":["await harness.goToScene('manual');","await harness.stepFrames(30);","const d = harness.getObjects('Dylan')[0];","harness.setObjectPosition(d.id, 1180, 100);","// bridge touch should NOT change scene instantly (fade first)","await harness.stepFrames(20);","const early = harness.getSceneName();","const f = harness.getObjects('Fundido')[0];","harness.assert(f !== undefined && f.hidden === false, 'fade sprite shown');","const changed = await harness.stepUntil(() => harness.getSceneName() === 'Nivel 1', {maxFrames: 300});","harness.assert(changed, 'scene changes after fade');","harness.assert(early === 'manual', 'no abrupt change, still manual during fade');"]},{"description":"Health bruja, J/K Dylan y bola","lastRunAt":1793332726428.0,"lastRunDurationMs":895.0,"lastRunFramesExecuted":152,"lastRunStatus":"passed","name":"bruja-enemiga","type":"gameplay","source":["await harness.goToScene('nivel 3');","await harness.stepFrames(30);","let brujas = harness.getObjects('vieja_bruja');","harness.assert(brujas.length>0, 'Hay brujas con Health');","let b0 = brujas[0];","console.log('Bruja HP beh='+JSON.stringify(b0.behaviors['Health'].state).slice(0,300));","harness.assert(b0.behaviors['Health']!==undefined, 'Bruja tiene Health');","// J ataque rapido","let d = harness.getNearby('Dylan','vieja_bruja',5000)[0];","let b = harness.getObjects('vieja_bruja')[0];","harness.setObjectPosition(d.id, b.centerX+40, b.centerY);","await harness.stepFrames(5);","harness.setKeyPressed('j', true);","await harness.stepFrames(3);","harness.setKeyPressed('j', false);","await harness.stepFrames(20);","let bAfterJ = harness.getObjects('vieja_bruja').find(o=>o.id===b.id);","console.log('Tras J bruja HP='+JSON.stringify(bAfterJ.behaviors['Health'].state.PropertyCurrentHealth));","// K ataque fuerte","let b2 = harness.getObjects('vieja_bruja')[0];","let d2 = harness.getObjects('Dylan')[0];","harness.setObjectPosition(d2.id, b2.centerX+40, b2.centerY);","await harness.stepFrames(30);","harness.setKeyPressed('k', true);","await harness.stepFrames(3);","harness.setKeyPressed('k', false);","await harness.stepFrames(20);","let bAfterK = harness.getObjects('vieja_bruja').find(o=>o.id===b2.id);","console.log('Tras K bruja HP='+JSON.stringify(bAfterK.behaviors['Health'].state.PropertyCurrentHealth));","harness.assert(true, 'Ataques J y K sin error');","// Ranged: alejar y esperar bola","let bb = harness.getObjects('vieja_bruja')[0];","let dd = harness.getObjects('Dylan')[0];","harness.setObjectPosition(dd.id, bb.centerX+250, bb.centerY);","await harness.stepUntil(()=>harness.getObjects('bola_del_ataque_2_de_bruja').length>0, {maxFrames: 300});","let bolas = harness.getObjects('bola_del_ataque_2_de_bruja');","harness.assert(bolas.length>0, 'Bola creada ranged, count='+bolas.length);"]},{"description":"J golpea bruja","lastRunAt":1793332764740.0,"lastRunDurationMs":702.0,"lastRunFramesExecuted":46,"lastRunStatus":"passed","name":"dylan-j-attack","type":"gameplay","source":["await harness.goToScene('nivel 3');","await harness.stepFrames(30);","let b = harness.getObjects('vieja_bruja')[0];","let d = harness.getNearby('Dylan','vieja_bruja',5000)[0];","harness.setObjectPosition(d.id, b.centerX+30, b.centerY);","await harness.stepFrames(2);","harness.setKeyPressed('j', true);","await harness.stepFrames(3);","harness.setKeyPressed('j', false);","await harness.stepFrames(10);","let bAfter = harness.getObjects('vieja_bruja').find(o=>o.id===b.id);","let hp = bAfter.behaviors['Health'].state.PropertyCurrentHealth;","console.log('Tras J HP='+hp);","harness.assert(hp<100, 'J dano a bruja, HP='+hp);"]}],"eventsFunctionsExtensions":[{"author":"@4ian","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"Health points and damage","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Health","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/heart-half-full.svg","shortDescription":"Health/life system: damage, shield, armor, regeneration, cooldown, and over-healing.","version":"0.4.0","description":["Manage health (life) points, shield and armor of instances of an object. ","","It handles:","- Damage cooldown","- Health and shield regeneration","- Over healing","","It can be used on:","- Players","- Enemies","- NPCs","- Inanimate objects (for insance breakable doors or mining rocks)","","The top-down RPG example uses this extension ([open the project online](https://editor.gdevelop.io/?project=example://top-down-rpg))."],"origin":{"identifier":"Health","name":"gdevelop-extension-store"},"tags":["health","life","damage","hit","heal","shield","regeneration","armor"],"authorIds":["wWP8BSlAW0UP4NeaHa2LcmmDzmH2","xpwUwByyImTDcHEqDUqfyg0oRBt1","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Manage health (life) points, shield and armor.","fullName":"Health","helpPath":"","iconUrl":"","name":"Health","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ResetObjectTimer"},"parameters":["Object","\"__Health.TimeSinceLastHit\""]},{"type":{"value":"Health::Health::SetCurrentHealth"},"parameters":["Object","Behavior","Health",""]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Health::Health","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"colorB":224,"colorG":16,"colorR":189,"creationTime":0,"name":"Health","source":"","type":"BuiltinCommonInstructions::Group","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Regeneration","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Health"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["HealthRegenRate","!=","0"]},{"type":{"value":"NumberVariable"},"parameters":["CurrentHealth","<","Object.Behavior::MaxHealth()"]},{"type":{"value":"CompareObjectTimer"},"parameters":["Object","\"__Health.TimeSinceLastHit\"",">","HealthRegenDelay"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentHealth","+","HealthRegenRate * TimeDelta()"]}],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Correct any values above maximum limits"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["CurrentHealth",">","Object.Behavior::MaxHealth()"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentHealth","=","MaxHealth"]}]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Reset triggers","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["IsHealthJustDamaged","False",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["IsJustHealed","False",""]},{"type":{"value":"SetBooleanVariable"},"parameters":["IsJustDodged","False",""]}]}],"parameters":[]}],"parameters":[]},{"colorB":224,"colorG":16,"colorR":189,"creationTime":0,"name":"Shield","source":"","type":"BuiltinCommonInstructions::Group","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Regeneration","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Shield"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["ShieldRegenRate","!=","0"]},{"type":{"value":"NumberVariable"},"parameters":["CurrentShieldPoints","<","MaxShieldPoints"]},{"type":{"value":"CompareObjectTimer"},"parameters":["Object","\"__Health.TimeSinceLastHit\"",">","ShieldRegenDelay"]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["CurrentShieldPoints","=","0"]}],"actions":[{"type":{"value":"Health::Health::RenewShieldDuration"},"parameters":["Object","Behavior",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentShieldPoints","+","ShieldRegenRate * TimeDelta()"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Correct any values above maximum limits"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["CurrentShieldPoints",">","MaxShieldPoints"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentShieldPoints","=","MaxShieldPoints"]}]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Remove shield points if shield expired","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"inverted":true,"value":"Health::Health::IsShieldActive"},"parameters":["Object","Behavior",""]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["CurrentShieldPoints","=","0"]}]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Reset damage trigger","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"a