ters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0,"shadowDistance":2000.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","shadowRenderingMode":"fittedToCameraView","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Health","type":"Health::Health"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"}]}],"externalEvents":[],"tests":[{"description":"Dylan stays on floor, moves right and jumps","lastRunAt":1790564033177.0,"lastRunDurationMs":870.0,"lastRunFramesExecuted":141,"lastRunStatus":"passed","name":"dylan-moves","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(60);","const d0 = harness.getObjects('Dylan')[0];","harness.assert(d0.y < 600, 'Dylan no atraviesa el suelo (y=' + d0.y + ')');","const x0 = d0.centerX;","harness.setKeyPressed('d', true);","await harness.stepFrames(60);","harness.setKeyPressed('d', false);","const d1 = harness.getObjects('Dylan')[0];","harness.assert(d1.centerX > x0 + 50, 'Dylan se mueve a la derecha con D (de ' + x0 + ' a ' + d1.centerX + ')');","const yBefore = d1.centerY;","harness.setKeyPressed('w', true);","await harness.stepFrames(10);","harness.setKeyPressed('w', false);","await harness.stepFrames(10);","const d2 = harness.getObjects('Dylan')[0];","harness.assert(d2.centerY < yBefore - 5, 'Dylan salta con W (de ' + yBefore + ' a ' + d2.centerY + ')');","await harness.takeScreenshot('player-fixed');"]},{"description":"Dylan flips left/right","lastRunAt":1790565065007.0,"lastRunDurationMs":181636.0,"lastRunFramesExecuted":91,"lastRunStatus":"passed","name":"dylan-flip","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(30);","harness.setKeyPressed('a', true);","await harness.stepFrames(30);","harness.setKeyPressed('a', false);","const d = harness.getObjects('Dylan')[0];","console.log(JSON.stringify(d.state));","harness.assert(harness.getRuntimeObject(d.id).isFlippedX() === true, 'Dylan mira a la izquierda (flip X activado)');","harness.setKeyPressed('d', true);","await harness.stepFrames(30);","harness.setKeyPressed('d', false);","const d2 = harness.getObjects('Dylan')[0];","harness.assert(harness.getRuntimeObject(d2.id).isFlippedX() === false, 'Dylan mira a la derecha (flip X desactivado)');"]},{"description":"Dylan idle/walk/run/hit/death animations","lastRunAt":1793327416554.0,"lastRunDurationMs":1449.0,"lastRunFramesExecuted":360,"lastRunStatus":"passed","name":"dylan-full-moves","type":"gameplay","source":["await harness.goToScene('Nivel 1');","await harness.stepFrames(90);","let d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'IDLE', 'Empieza en IDLE, actual: ' + d.animation);","const x0 = d.centerX;","harness.setKeyPressed('d', true);","await harness.stepFrames(40);","d = harness.getObjects('Dylan')[0];","harness.assert(d.centerX > x0 + 15, 'Camina derecha');","harness.assert(d.animation === 'walk', 'walk al caminar, actual: ' + d.animation);","harness.setKeyPressed('d', false);","await harness.stepFrames(20);","harness.setKeyPressed('LShift', true);","harness.setKeyPressed('d', true);","await harness.stepFrames(15);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'run', 'run al correr con Shift, actual: ' + d.animation);","harness.setKeyPressed('d', false);","harness.setKeyPressed('LShift', false);","await harness.stepFrames(20);","const x2 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('a', true);","await harness.stepFrames(40);","harness.setKeyPressed('a', false);","d = harness.getObjects('Dylan')[0];","harness.assert(d.centerX < x2 - 15, 'Camina izquierda');","await harness.stepFrames(20);","harness.setKeyPressed('h', true);","await harness.stepFrames(2);","harness.setKeyPressed('h', false);","await harness.stepFrames(5);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'golpeado', 'golpeado tras H, actual: ' + d.animation);","await harness.stepFrames(60);","harness.setKeyPressed('j', true);","await harness.stepFrames(5);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'Golpes', 'Golpes al pulsar J, actual: ' + d.animation);","harness.setKeyPressed('j', false);","await harness.stepFrames(30);","harness.setKeyPressed('k', true);","await harness.stepFrames(2);","harness.setKeyPressed('k', false);","await harness.stepFrames(10);","d = harness.getObjects('Dylan')[0];","harness.assert(d.animation === 'Muerte', 'Muerte tras K, actual: ' + d.animation);","await harness.takeScreenshot('final');"]},{"description":"WASD and arrows move Dylan","lastRunAt":1792644983721.0,"lastRunDurationMs":859.0,"lastRunFramesExecuted":377,"lastRunStatus":"passed","name":"dylan-wasd-arrows","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(90);","let d = harness.getObjects('Dylan')[0];","const cx = d.centerX;","// A izquierda"," harness.setKeyPressed('a', true); await harness.stepFrames(30); harness.setKeyPressed('a', false);","let d1 = harness.getObjects('Dylan')[0];","harness.assert(d1.centerX < cx - 10, 'A mueve izquierda');","await harness.stepFrames(20);","// D derecha","const cx2 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('d', true); await harness.stepFrames(30); harness.setKeyPressed('d', false);","let d2 = harness.getObjects('Dylan')[0];","harness.assert(d2.centerX > cx2 + 10, 'D mueve derecha');","await harness.stepFrames(20);","// Flecha izquierda","const cx3 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('Left', true); await harness.stepFrames(30); harness.setKeyPressed('Left', false);","let d3 = harness.getObjects('Dylan')[0];","harness.assert(d3.centerX < cx3 - 10, 'Flecha izq mueve');","await harness.stepFrames(20);","// Flecha derecha","const cx4 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('Right', true); await harness.stepFrames(30); harness.setKeyPressed('Right', false);","let d4 = harness.getObjects('Dylan')[0];","harness.assert(d4.centerX > cx4 + 10, 'Flecha der mueve');","// W salta","await harness.stepFrames(20);","const y0 = harness.getObjects('Dylan')[0].centerY;","harness.setKeyPressed('w', true); await harness.stepFrames(10); harness.setKeyPressed('w', false);","await harness.stepFrames(10);","let d5 = harness.getObjects('Dylan')[0];","harness.assert(d5.centerY < y0 - 5, 'W salta (y ' + y0 + ' -> ' + d5.centerY + ')');","// Up salta","await harness.stepUntilObjectIsStable('Dylan', {maxFrames: 120});","const y1 = harness.getObjects('Dylan')[0].centerY;","harness.setKeyPressed('Up', true); await harness.stepFrames(10); harness.setKeyPressed('Up', false);","await harness.stepFrames(10);","let d6 = harness.getObjects('Dylan')[0];","harness.assert(d6.centerY < y1 - 5, 'Up salta');","await harness.takeScreenshot('final');"]},{"description":"Camera X follow fixed Y","lastRunAt":1793327420382.0,"lastRunDurationMs":1366.0,"lastRunFramesExecuted":234,"lastRunStatus":"passed","name":"dylan-camera","type":"gameplay","source":["await harness.goToScene('Nivel 1');","await harness.stepFrames(90);","const cam0 = harness.getCameraState('');","harness.setKeyPressed('d', true);","await harness.stepFrames(120);","harness.setKeyPressed('d', false);","const cam1 = harness.getCameraState('');","const d1 = harness.getObjects('Dylan')[0];","harness.assert(Math.abs(cam1.x - cam0.x) > 20, 'Camara sigue en X (' + Math.round(cam0.x) + ' -> ' + Math.round(cam1.x) + ')');","harness.assert(Math.abs(cam1.y - cam0.y) < 5, 'Camara fija en Y (' + Math.round(cam0.y) + ' -> ' + Math.round(cam1.y) + ')');","// saltar: la camara no debe moverse en Y","const camJ0 = harness.getCameraState('');","harness.setKeyPressed('w', true); await harness.stepFrames(8); harness.setKeyPressed('w', false);","await harness.stepFrames(15);","const camJ1 = harness.getCameraState('');","harness.assert(Math.abs(camJ1.y - camJ0.y) < 5, 'Al saltar no se ve vacio (Y estable)');","await harness.takeScreenshot('camara-fija');"]},{"description":"Intro MUTE button toggles Silenciado and SKIP button jumps to Nivel 1","lastRunAt":1793220700055.0,"lastRunDurationMs":1425.0,"lastRunFramesExecuted":25,"lastRunStatus":"passed","name":"intro-buttons","type":"gameplay","source":["await harness.goToScene('introduccion');","await harness.stepFrames(3);","const mute = harness.getObjects('MuteButton');","const skip = harness.getObjects('SkipButton');","harness.assert(mute.length === 1, 'MuteButton exists on intro scene');","harness.assert(skip.length === 1, 'SkipButton exists on intro scene');","","async function click(x, y) {","  harness.setMousePosition(x, y);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepFrames(3);","}","","const mcx = mute[0].centerX, mcy = mute[0].centerY;","await click(mcx, mcy);","const v1 = harness.getSceneVariable('Silenciado');","harness.assert(!!v1 && v1.value === true, 'First MUTE click sets Silenciado to true (was ' + JSON.stringify(v1 && v1.value) + ')');","await click(mcx, mcy);","const v2 = harness.getSceneVariable('Silenciado');","harness.assert(!!v2 && v2.value === false, 'Second MUTE click sets Silenciado back to false (was ' + JSON.stringify(v2 && v2.value) + ')');","","harness.assert(harness.getSceneName() === 'introduccion', 'Still on intro scene before pressing SKIP');","await click(skip[0].centerX, skip[0].centerY);","harness.assert(harness.getSceneName() === 'Nivel 1', 'SKIP button jumps to Nivel 1 (current: ' + harness.getSceneName() + ')');"]},{"description":"Pixel-art intro controls: mute frame bottom-left toggles volume, chevron icon top-right skips to Nivel 1","lastRunAt":1793221381324.0,"lastRunDurationMs":1527.0,"lastRunFramesExecuted":25,"lastRunStatus":"passed","name":"intro-pixel-controls","type":"gameplay","source":["await harness.goToScene('introduccion');","await harness.stepFrames(3);","const frame = harness.getObjects('BotonPixel');","const skip = harness.getObjects('IconoSkip');","harness.assert(frame.length === 1, 'BotonPixel (pixel mute frame) exists');","harness.assert(skip.length === 1, 'IconoSkip (pixel chevron) exists');","harness.assert(skip[0].x > 400 && skip[0].y < 50, 'skip icon sits in the top-right corner (' + skip[0].x + ',' + skip[0].y + ')');","","async function click(x, y) {","  harness.setMousePosition(x, y);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepFrames(3);","}","","await click(frame[0].centerX, frame[0].centerY);","const v1 = harness.getSceneVariable('Silenciado');","harness.assert(!!v1 && v1.value === true, 'clicking the pixel MUTE frame mutes (was ' + JSON.stringify(v1 && v1.value) + ')');","const label1 = harness.getObjects('EtiquetaMute')[0];","harness.assert(label1 && label1.text === 'UNMUTE', 'pixel label switches to UNMUTE (got ' + (label1 && label1.text) + ')');","","await click(frame[0].centerX, frame[0].centerY);","const v2 = harness.getSceneVariable('Silenciado');","harness.assert(!!v2 && v2.value === false, 'second click unmutes (was ' + JSON.stringify(v2 && v2.value) + ')');","const label2 = harness.getObjects('EtiquetaMute')[0];","harness.assert(label2 && label2.text === 'MUTE', 'pixel label back to MUTE (got ' + (label2 && label2.text) + ')');","","await click(skip[0].centerX, skip[0].centerY);","harness.assert(harness.getSceneName() === 'Nivel 1', 'clicking the top-right skip icon jumps to Nivel 1 (current: ' + harness.getSceneName() + ')');"]},{"description":"Manual UI layout and playability","lastRunAt":1793243342446.0,"lastRunDurationMs":1788.0,"lastRunFramesExecuted":151,"lastRunStatus":"passed","name":"manual-ui-check","type":"gameplay","source":["await harness.goToScene('manual');","await harness.stepFrames(30);","// UI texts present","for (const t of ['ManualTitulo','ManualMovimiento','ManualIzquierda','ManualDerecha','ManualArriba','ManualAbajo','ManualEspacio']) {","  const o = harness.getObjects(t);","  harness.assert(o.length > 0, t+' exists');","}","const titulo = harness.getObjects('ManualTitulo')[0];","harness.assert((titulo.text||'').includes('CÓMO JUGAR'), 'title text ok: '+titulo.text);","// keys present with right animations","for (const [o,exp] of [['TeclaA','A'],['TeclaD','D'],['TeclaW','W'],['TeclaJ','J'],['TeclaK','K']]) {","  const k = harness.getObjects(o);","  harness.assert(k.length > 0, o+' exists');","  if (k.length) harness.assert(k[0].animation === exp, o+' anim '+k[0].animation+' expected '+exp);","}","// arrows + space glyphs","for (const g of ['FlechaT_Izq','FlechaT_Der','FlechaT_Up','FlechaT_Down','BarraEsp']) harness.assert(harness.getObjects(g).length>0, g+' exists');","// Dylan on floor, moves right","await harness.stepFrames(60);","const x0 = harness.getObjects('Dylan')[0].centerX;","harness.setKeyPressed('d', true);","await harness.stepFrames(60);","harness.setKeyPressed('d', false);","const x1 = harness.getObjects('Dylan')[0].centerX;","harness.assert(x1 > x0 + 20, 'Dylan moves on floor');","await harness.takeScreenshot('manual-ui');"]},{"description":"Gap fall and respawn check v3","lastRunAt":1793244625618.0,"lastRunDurationMs":2350.0,"lastRunFramesExecuted":74,"lastRunStatus":"passed","name":"manual-gap-fall","type":"gameplay","source":["await harness.goToScene('manual');","await harness.stepFrames(30);","const d = harness.getObjects('Dylan')[0];","harness.setObjectPosition(d.id, 610, 100);","const fell = await harness.stepUntil(() => {","  const p = harness.getObjects('Dylan')[0];","  return p && p.y > 300;","}, {maxFrames: 300});","harness.assert(fell, 'Dylan falls through the gap (no floor at x=610)');","const back = await harness.stepUntil(() => {","  const p = harness.getObjects('Dylan')[0];","  return p && p.y < 200;","}, {maxFrames: 300});","harness.assert(back, 'Dylan respawned after falling');","const p2 = harness.getObjects('Dylan')[0];","harness.assert(Math.abs(p2.x - 40) < 80, 'respawned near start, x='+p2.x);"]},{"description":"Fade transition on bridge exit","lastRunAt":1793246629187.0,"lastRunDurationMs":4294.0,"lastRunFramesExecuted":97,"lastRunStatus":"passed","name":"manual-skip-bridge","type":"gameplay","source":["await harness.goToScene('manual');","await harness.stepFrames(30);","const d = harness.getObjects('Dylan')[0];","harness.setObjectPosition(d.id, 1180, 100);","// bridge touch should NOT change scene instantly (fade first)","await harness.stepFrames(20);","const early = harness.getSceneName();","const f = harness.getObjects('Fundido')[0];","harness.assert(f !== undefined && f.hidden === false, 'fade sprite shown');","const changed = await harness.stepUntil(() => harness.getSceneName() === 'Nivel 1', {maxFrames: 300});","harness.assert(changed, 'scene changes after fade');","harness.assert(early === 'manual', 'no abrupt change, still manual during fade');"]},{"description":"Barra de vida fija en la capa UI y sincronizada, recogida de morrón en la olla y cadena walk/run/IDLE","lastRunAt":1793327534134.0,"lastRunDurationMs":3010.0,"lastRunFramesExecuted":108,"lastRunStatus":"passed","name":"vida-inventario-animaciones","type":"gameplay","source":["await harness.goToScene('Nivel 1');","await harness.stepFrames(6);","","const dylan0 = harness.getObjects('Dylan')[0];","const dylanId = dylan0.id;","console.log('dylan start', dylan0.x, dylan0.y, 'anim=', dylan0.animation);","","const bar0 = harness.getObjects('White1BitPixelBar')[0];","harness.assert(!!bar0, 'Existe la barra de vida White1BitPixelBar');","harness.assert(bar0 && bar0.layer === 'barra_vida', 'La barra esta en la capa fija barra_vida (layer=' + (bar0 && bar0.layer) + ')');","const barX0 = bar0 ? bar0.x : -1;","const barY0 = bar0 ? bar0.y : -1;","const cam0 = harness.getCameraState('');","","// --- Animaciones: caminar ---","harness.setKeyPressed('Right', true);","const walkOk = await harness.stepUntil(() => (harness.getObjects('Dylan')[0].animation || '') === 'walk', { maxFrames: 90 });","harness.assert(walkOk, 'Al moverse sin Shift se reproduce walk (anim=' + harness.getObjects('Dylan')[0].animation + ')');","","// --- Animaciones: correr y camara con Dylan lejos ---","harness.setKeyPressed('LShift', true);","const runOk = await harness.stepUntil(() => (harness.getObjects('Dylan')[0].animation || '') === 'run', { maxFrames: 90 });","harness.assert(runOk, 'Con Shift se reproduce run (anim=' + harness.getObjects('Dylan')[0].animation + ')');","await harness.stepUntil(() => harness.getObjects('Dylan')[0].x > 420, { maxFrames: 220 });","harness.setKeyPressed('LShift', false);","harness.setKeyPressed('Right', false);","console.log('dylan after run', harness.getObjects('Dylan')[0].x);","","// --- Volver a IDLE al soltar ---","const idleOk = await harness.stepUntil(() => (harness.getObjects('Dylan')[0].animation || '') === 'IDLE', { maxFrames: 250 });","harness.assert(idleOk, 'Al soltar las teclas vuelve a IDLE (anim=' + harness.getObjects('Dylan')[0].animation + ')');","","// --- La barra no se mueve aunque se mueva la camara ---","const cam1 = harness.getCameraState('');","console.log('cam', JSON.stringify(cam0), '->', JSON.stringify(cam1));","const bar1 = harness.getObjects('White1BitPixelBar')[0];","harness.assert(bar1 && bar1.x === barX0 && bar1.y === barY0, 'La barra queda fija en pantalla al moverse la camara (' + (bar1 && bar1.x) + ',' + (bar1 && bar1.y) + ')')","harness.assert(!cam0 || !cam1 || cam1.x !== cam0.x, 'La camara se movio con Dylan (cam x ' + (cam0 && cam0.x) + ' -> ' + (cam1 && cam1.x) + ')');","","// --- Dano: H hace 25 ---","const hp0 = Number(harness.getGlobalVariable('VidaDylan').value);","harness.assert(hp0 === 100, 'La vida global empieza en 100 (VidaDylan=' + hp0 + ')');","harness.setKeyPressed('h', true);","await harness.stepFrames(2);","harness.setKeyPressed('h', false);","await harness.stepFrames(4);","const hp1 = Number(harness.getGlobalVariable('VidaDylan').value);","harness.assert(hp1 === 75, 'Recibir 25 de dano baja la vida a 75 (VidaDylan=' + hp1 + ')');","const dylanHit = harness.getObjects('Dylan')[0];","harness.assert((dylanHit.animation || '') === 'golpeado', 'Al recibir dano se reproduce golpeado (anim=' + dylanHit.animation + ')');","const barState = harness.getObjects('White1BitPixelBar')[0];","console.log('bar state', JSON.stringify(barState && barState.state));","harness.assert(JSON.stringify(barState.state).indexOf('75') >= 0, 'La barra de vida se actualiza a 75 (' + JSON.stringify(barState.state) + ')');","","// --- Recoger un morron ---","const morronBefore = harness.getObjects('asset_morron').length;","harness.setObjectPosition(dylanId, 1741, 150);","const picked = await harness.stepUntil(() => Number(harness.getGlobalVariable('Morron').value) >= 1, { maxFrames: 150 });","harness.assert(picked, 'Tocar el morron suma 1 a la global Morron (Morron=' + harness.getGlobalVariable('Morron').value + ')');","harness.assert(harness.getObjects('asset_morron').length === morronBefore - 1, 'El morron recogido desaparece del escenario');","const txt = harness.getObjects('TxtMorron')[0];","console.log('txt morron', txt && txt.text, 'hidden=', txt && txt.hidden);","harness.assert(!!txt && /MORRON x1/.test(txt.text || ''), 'El panel de la olla muestra MORRON x1 (' + (txt && txt.text) + ')');","","// --- Cerrar y abrir el panel con I ---","harness.setKeyPressed('i', true);","await harness.stepFrames(2);","harness.setKeyPressed('i', false);","await harness.stepFrames(4);","harness.assert(harness.getObjects('TxtMorron')[0].hidden === true, 'La tecla I cierra el panel del inventario');","harness.setKeyPressed('i', true);","await harness.stepFrames(2);","harness.setKeyPressed('i', false);","await harness.stepFrames(4);","harness.assert(harness.getObjects('TxtMorron')[0].hidden === false, 'La tecla I vuelve a abrir el panel del inventario');","","await harness.takeScreenshot('final');",""]},{"description":"Derrota: animación Muerte, vida a 0, reaparición con vida completa y una sola barra","lastRunAt":1793327541975.0,"lastRunDurationMs":2686.0,"lastRunFramesExecuted":162,"lastRunStatus":"passed","name":"muerte-y-respawn","type":"gameplay","source":["await harness.goToScene('Nivel 1');","await harness.stepFrames(6);","harness.setKeyPressed('k', true);","await harness.stepFrames(2);","harness.setKeyPressed('k', false);","await harness.stepFrames(3);","const hp0 = Number(harness.getGlobalVariable('VidaDylan').value);","harness.assert(hp0 === 0, 'Con 200 de dano la vida queda en 0 (VidaDylan=' + hp0 + ')');","const deadAnim = harness.getObjects('Dylan')[0].animation;","harness.assert(deadAnim === 'Muerte', 'Al morir se reproduce la animacion Muerte (anim=' + deadAnim + ')');","await harness.stepFrames(110);","const hp1 = Number(harness.getGlobalVariable('VidaDylan').value);","const d = harness.getObjects('Dylan')[0];","console.log('after respawn', hp1, d.x, d.y, d.animation);","harness.assert(hp1 === 100, 'Tras la derrota la vida vuelve a 100 (VidaDylan=' + hp1 + ')');","harness.assert(Math.abs(d.x - 240) < 60, 'Dylan reaparece en el inicio del nivel (x=' + d.x + ')');","harness.assert(harness.getObjects('White1BitPixelBar').length === 1, 'Sigue habiendo una sola barra de vida');","await harness.stepFrames(40);","harness.assert((harness.getObjects('Dylan')[0].animation || '') === 'IDLE', 'Tras reaparecer vuelve a IDLE (anim=' + harness.getObjects('Dylan')[0].animation + ')');","await harness.takeScreenshot('respawn');",""]}],"eventsFunctionsExtensions":[{"author":"@4ian","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"Health points and damage","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"Health","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/heart-half-full.svg","shortDescription":"Health/life system: damage, shield, armor, regeneration, cooldown, and over-healing.","version":"0.4.0","description":["Manage health (life) points, shield and armor of instances of an object. ","","It handles:","- Damage cooldown","- Health and shield regeneration","- Over healing","","It can be used on:","- Players","- Enemies","- NPCs","- Inanimate objects (for insance breakable doors or mining rocks)","","The top-down RPG example uses this extension ([open the project online](https://editor.gdevelop.io/?project=example://top-down-rpg))."],"origin":{"identifier":"Health","name":"gdevelop-extension-store"},"tags":["health","life","damage","hit","heal","shield","regeneration","armor"],"authorIds":["wWP8BSlAW0UP4NeaHa2LcmmDzmH2","xpwUwByyImTDcHEqDUqfyg0oRBt1","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"Manage health (life) points, shield and armor.","fullName":"Health","helpPath":"","iconUrl":"","name":"Health","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ResetObjectTimer"},"parameters":["Object","\"__Health.TimeSinceLa